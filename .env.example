# API Keys and External URLs
# Get your NVD API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# MITRE ATT&CK data source URL
MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json

# Local MLflow/MinIO credentials. Replace these values before starting Docker.
MINIO_ROOT_USER=change-me-user
MINIO_ROOT_PASSWORD=change-me-password-at-least-8-chars
MLFLOW_TRACKING_URI=http://localhost:5000
